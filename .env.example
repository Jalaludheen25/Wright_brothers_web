# ---------------------------------------------------------------------------
# Wright Brothers — environment
# Copy to .env.local for development, and set the same keys in your host.
# ---------------------------------------------------------------------------

# Canonical origin. Used for sitemap.xml, robots.txt, canonical tags, JSON-LD
# and Open Graph URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://wrightbrothers.ae

# --- Form delivery --------------------------------------------------------
# The contact and newsletter endpoints need ONE of the two options below.
# Without either, both forms return HTTP 503 and tell the visitor to phone or
# email instead — deliberately, so enquiries are never silently discarded.

# Option 1 — transactional email via Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=studio@wrightbrothers.ae
# CONTACT_FROM_EMAIL=Wright Brothers <website@wrightbrothers.ae>

# Option 2 — POST the submission as JSON to any endpoint
# (Zapier / Make / n8n / a CRM webhook / a Slack workflow)
# FORM_WEBHOOK_URL=https://hooks.example.com/wright-brothers
